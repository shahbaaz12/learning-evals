  {
    "id": "q004",
    "difficulty": "intermediate",
    "question": "As of 2026-10-01, which current Development employees earn more than the average current Development salary? Return employee ID, first name, last name, and annual salary. Order by salary descending, then employee ID ascending.",
    "sql": "WITH reporting_date AS (SELECT '2026-10-01' AS dt),\ndev_dept AS (\n    SELECT dept_no FROM departments WHERE dept_name = 'Development'\n),\ncurrent_emp AS (\n    SELECT de.emp_no, e.first_name, e.last_name, s.salary\n    FROM dept_emp de\n    JOIN dev_dept d ON de.dept_no = d.dept_no\n    JOIN employees e ON e.emp_no = de.emp_no\n    JOIN salaries s ON s.emp_no = e.emp_no\n    CROSS JOIN reporting_date rd\n    WHERE de.from_date <= rd.dt AND de.to_date > rd.dt\n      AND s.from_date <= rd.dt AND s.to_date > rd.dt\n),\navg_salary AS (\n    SELECT ROUND(AVG(salary), 2) AS avg_sal FROM current_emp\n)\nSELECT ce.emp_no AS employee_id,\n       ce.first_name,\n       ce.last_name,\n       ce.salary AS annual_salary\nFROM current_emp ce, avg_salary a\nWHERE ce.salary > a.avg_sal\nORDER BY ce.salary DESC, ce.emp_no ASC;",
