  {
    "id": "q006",
    "difficulty": "difficult",
    "question": "As of 2026-10-01, which current employees received at least a 10 percent raise from their immediately previous salary to their current salary? Exclude employees with no previous salary. Return employee ID, first name, last name, current department name, previous salary, current salary, and percentage raise rounded to two decimals. Order by percentage raise descending, then employee ID ascending.",
    "sql": "WITH current_salaries AS (\n    SELECT s.emp_no,\n           s.salary AS current_salary,\n           s.from_date AS cur_from,\n           s.to_date AS cur_to\n    FROM salaries s\n    WHERE s.from_date <= '2026-10-01' AND s.to_date > '2026-10-01'\n),\nprevious_salaries AS (\n    SELECT s.emp_no,\n           MAX(s.from_date) AS prev_from\n    FROM salaries s\n    JOIN current_salaries c ON s.emp_no = c.emp_no\n    WHERE s.from_date < c.cur_from\n    GROUP BY s.emp_no\n),\nprev_salary_vals AS (\n    SELECT s.emp_no,\n           s.salary AS previous_salary\n    FROM salaries s\n    JOIN previous_salaries p ON s.emp_no = p.emp_no AND s.from_date = p.prev_from\n),\nactive_depts AS (\n    SELECT de.emp_no,\n           d.dept_name\n    FROM dept_emp de\n    JOIN departments d ON de.dept_no = d.dept_no\n    WHERE de.from_date <= '2026-10-01' AND de.to_date > '2026-10-01'\n)\nSELECT e.emp_no,\n       e.first_name,\n       e.last_name,\n       ad.dept_name,\n       ps.previous_salary,\n       cs.current_salary,\n       ROUND( (cs.current_salary - ps.previous_salary) * 100.0 / ps.previous_salary , 2) AS pct_raise\nFROM current_salaries cs\nJOIN prev_salary_vals ps ON cs.emp_no = ps.emp_no\nJOIN employees e ON e.emp_no = cs.emp_no\nJOIN active_depts ad ON ad.emp_no = e.emp_no\nWHERE (cs.current_salary - ps.previous_salary) * 100.0 / ps.previous_salary >= 10\nORDER BY pct_raise DESC, e.emp_no ASC;",
