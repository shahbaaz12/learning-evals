  {
    "id": "q005",
    "difficulty": "difficult",
    "question": "As of 2026-10-01, list current employees at the two highest distinct salary ranks in each department, including ties. Return department name, employee ID, first name, last name, salary, and salary rank. Order by department name, rank, then employee ID.",
    "sql": "WITH active_emp AS (\n    SELECT e.emp_no, e.first_name, e.last_name, d.dept_no, d.dept_name, s.salary,\n           DENSE_RANK() OVER (PARTITION BY d.dept_no ORDER BY s.salary DESC) AS dept_salary_rank\n    FROM employees e\n    JOIN dept_emp de ON e.emp_no = de.emp_no\n    JOIN departments d ON de.dept_no = d.dept_no\n    JOIN salaries s ON e.emp_no = s.emp_no\n    WHERE de.from_date <= '2026-10-01' AND de.to_date > '2026-10-01'\n      AND s.from_date <= '2026-10-01' AND s.to_date > '2026-10-01'\n)\nSELECT dept_name,\n       emp_no AS employee_id,\n       first_name,\n       last_name,\n       salary,\n       dept_salary_rank AS salary_rank\nFROM active_emp\nWHERE dept_salary_rank <= 2\nORDER BY dept_name, salary_rank, emp_no;",
