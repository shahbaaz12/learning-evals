  {
    "id": "q003",
    "difficulty": "intermediate",
    "question": "As of 2026-10-01, show every department name, its current employee count, and average current annual salary rounded to two decimals. Include empty departments with count 0 and average NULL. Order by department name.",
    "sql": "WITH active_emp AS (\n    SELECT de.emp_no, de.dept_no\n    FROM dept_emp de\n    WHERE de.from_date <= '2026-10-01' AND de.to_date > '2026-10-01'\n),\nactive_sal AS (\n    SELECT s.emp_no, s.salary\n    FROM salaries s\n    WHERE s.from_date <= '2026-10-01' AND s.to_date > '2026-10-01'\n)\nSELECT d.dept_name,\n       COUNT(DISTINCT ae.emp_no) AS employee_count,\n       ROUND(AVG(asal.salary), 2) AS average_salary\nFROM departments d\nLEFT JOIN active_emp ae ON d.dept_no = ae.dept_no\nLEFT JOIN active_sal asal ON ae.emp_no = asal.emp_no\nGROUP BY d.dept_name\nORDER BY d.dept_name;",
