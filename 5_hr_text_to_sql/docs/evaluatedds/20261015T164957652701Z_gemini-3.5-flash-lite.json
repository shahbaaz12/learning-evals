  {
    "id": "q006",
    "difficulty": "difficult",
    "question": "As of 2026-10-01, which current employees received at least a 10 percent raise from their immediately previous salary to their current salary? Exclude employees with no previous salary. Return employee ID, first name, last name, current department name, previous salary, current salary, and percentage raise rounded to two decimals. Order by percentage raise descending, then employee ID ascending.",
    "sql": "SELECT \n    e.emp_no,\n    e.first_name,\n    e.last_name,\n    d.dept_name,\n    prev_sal.salary AS previous_salary,\n    curr_sal.salary AS current_salary,\n    ROUND(CAST((curr_sal.salary - prev_sal.salary) AS REAL) / prev_sal.salary * 100, 2) AS percentage_raise\nFROM employees e\nJOIN dept_emp de ON e.emp_no = de.emp_no \n    AND de.from_date <= '2026-10-01' AND de.to_date > '2026-10-01'\nJOIN departments d ON de.dept_no = d.dept_no\nJOIN salaries curr_sal ON e.emp_no = curr_sal.emp_no \n    AND curr_sal.from_date <= '2026-10-01' AND curr_sal.to_date > '2026-10-01'\nJOIN salaries prev_sal ON e.emp_no = prev_sal.emp_no\n    -- Find the salary whose to_date matches the current salary's from_date (immediately preceding)\n    AND prev_sal.to_date = curr_sal.from_date\nWHERE ROUND(CAST((curr_sal.salary - prev_sal.salary) AS REAL) / prev_sal.salary * 100, 2) >= 10.00\nORDER BY percentage_raise DESC, e.emp_no ASC;",
