  {
    "id": "q005",
    "difficulty": "difficult",
    "question": "As of 2026-10-01, list current employees at the two highest distinct salary ranks in each department, including ties. Return department name, employee ID, first name, last name, salary, and salary rank. Order by department name, rank, then employee ID.",
    "sql": "WITH active_dept AS (\n    SELECT de.dept_no, de.emp_no\n    FROM dept_emp de\n    WHERE de.from_date <= '2026-10-01' AND de.to_date > '2026-10-01'\n),\nactive_sal AS (\n    SELECT s.emp_no, s.salary\n    FROM salaries s\n    WHERE s.from_date <= '2026-10-01' AND s.to_date > '2026-10-01'\n),\ndept_salaries AS (\n    SELECT \n        d.dept_name,\n        e.emp_no,\n        e.first_name,\n        e.last_name,\n        s.salary,\n        d.dept_no,\n        DENSE_RANK() OVER (PARTITION BY d.dept_no ORDER BY s.salary DESC) as salary_rank\n    FROM active_dept ad\n    JOIN departments d ON ad.dept_no = d.dept_no\n    JOIN employees e ON ad.emp_no = e.emp_no\n    JOIN active_sal s ON e.emp_no = s.emp_no\n)\nSELECT \n    dept_name,\n    emp_no,\n    first_name,\n    last_name,\n    salary,\n    salary_rank\nFROM dept_salaries\nWHERE salary_rank <= 2\nORDER BY dept_name, salary_rank, emp_no;",
