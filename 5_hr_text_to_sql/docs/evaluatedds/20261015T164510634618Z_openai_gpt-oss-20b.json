  {
    "id": "q005",
    "difficulty": "difficult",
    "question": "As of 2026-10-01, list current employees at the two highest distinct salary ranks in each department, including ties. Return department name, employee ID, first name, last name, salary, and salary rank. Order by department name, rank, then employee ID.",
    "sql": "WITH reporting_date AS (SELECT '2026-10-01' AS d),\n     active_dept_emp AS (\n       SELECT de.emp_no, de.dept_no\n       FROM dept_emp de\n       JOIN reporting_date rd\n         ON de.from_date <= rd.d AND de.to_date > rd.d\n     ),\n     active_salaries AS (\n       SELECT s.emp_no, s.salary\n       FROM salaries s\n       JOIN reporting_date rd\n         ON s.from_date <= rd.d AND s.to_date > rd.d\n     ),\n     dept_emp_salary AS (\n       SELECT a.dept_no, a.emp_no, e.first_name, e.last_name, s.salary\n       FROM active_dept_emp a\n       JOIN active_salaries s ON a.emp_no = s.emp_no\n       JOIN employees e ON a.emp_no = e.emp_no\n     ),\n     salary_rank AS (\n       SELECT dept_no,\n              salary,\n              DENSE_RANK() OVER (PARTITION BY dept_no ORDER BY salary DESC) AS rank\n       FROM dept_emp_salary\n       GROUP BY dept_no, salary\n     )\nSELECT d.dept_name,\n       des.emp_no,\n       des.first_name,\n       des.last_name,\n       des.salary,\n       sr.rank AS salary_rank\nFROM dept_emp_salary des\nJOIN salary_rank sr\n  ON des.dept_no = sr.dept_no AND des.salary = sr.salary\nJOIN departments d ON des.dept_no = d.dept_no\nWHERE sr.rank <= 2\nORDER BY d.dept_name, sr.rank, des.emp_no;",
