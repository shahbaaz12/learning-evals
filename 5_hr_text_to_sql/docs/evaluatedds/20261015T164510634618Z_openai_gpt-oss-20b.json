  {
    "id": "q004",
    "difficulty": "intermediate",
    "question": "As of 2026-10-01, which current Development employees earn more than the average current Development salary? Return employee ID, first name, last name, and annual salary. Order by salary descending, then employee ID ascending.",
    "sql": "WITH reporting_date AS (SELECT '2026-10-01' AS d),\n     active_dept AS (\n       SELECT de.emp_no\n       FROM dept_emp de\n       JOIN reporting_date rd ON de.from_date <= rd.d AND de.to_date > rd.d\n       JOIN departments d ON de.dept_no = d.dept_no\n       WHERE d.dept_name = 'Development'\n     ),\n     active_salary AS (\n       SELECT s.emp_no, s.salary\n       FROM salaries s\n       JOIN reporting_date rd ON s.from_date <= rd.d AND s.to_date > rd.d\n     ),\n     current_employees AS (\n       SELECT e.emp_no, e.first_name, e.last_name, s.salary\n       FROM employees e\n       JOIN active_dept ad ON e.emp_no = ad.emp_no\n       JOIN active_salary s ON e.emp_no = s.emp_no\n     ),\n     avg_salary AS (\n       SELECT AVG(salary) AS avg_sal FROM current_employees\n     )\nSELECT ce.emp_no, ce.first_name, ce.last_name, ce.salary\nFROM current_employees ce, avg_salary a\nWHERE ce.salary > a.avg_sal\nORDER BY ce.salary DESC, ce.emp_no ASC;",
