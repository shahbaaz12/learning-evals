  {
    "id": "q006",
    "difficulty": "difficult",
    "question": "As of 2026-10-01, which current employees received at least a 10 percent raise from their immediately previous salary to their current salary? Exclude employees with no previous salary. Return employee ID, first name, last name, current department name, previous salary, current salary, and percentage raise rounded to two decimals. Order by percentage raise descending, then employee ID ascending.",
    "sql": "WITH reporting_date AS (SELECT '2026-10-01' AS d),\n     current_salary AS (\n       SELECT s.emp_no, s.salary AS current_salary, s.from_date\n       FROM salaries s, reporting_date r\n       WHERE s.from_date <= r.d AND s.to_date > r.d\n     ),\n     previous_salary AS (\n       SELECT s.emp_no, s.salary AS previous_salary\n       FROM salaries s\n       JOIN current_salary cs ON s.emp_no = cs.emp_no\n       WHERE s.to_date = cs.from_date\n     ),\n     current_dept AS (\n       SELECT de.emp_no, d.dept_name\n       FROM dept_emp de\n       JOIN departments d ON de.dept_no = d.dept_no\n       JOIN reporting_date r ON de.from_date <= r.d AND de.to_date > r.d\n     )\nSELECT e.emp_no,\n       e.first_name,\n       e.last_name,\n       cd.dept_name,\n       ps.previous_salary,\n       cs.current_salary,\n       ROUND((cs.current_salary - ps.previous_salary) * 100.0 / ps.previous_salary, 2) AS percentage_raise\nFROM employees e\nJOIN current_salary cs ON e.emp_no = cs.emp_no\nJOIN previous_salary ps ON e.emp_no = ps.emp_no\nJOIN current_dept cd ON e.emp_no = cd.emp_no\nORDER BY percentage_raise DESC, e.emp_no ASC;",
