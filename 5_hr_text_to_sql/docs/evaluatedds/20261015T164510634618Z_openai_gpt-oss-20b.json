  {
    "id": "q003",
    "difficulty": "intermediate",
    "question": "As of 2026-10-01, show every department name, its current employee count, and average current annual salary rounded to two decimals. Include empty departments with count 0 and average NULL. Order by department name.",
    "sql": "SELECT\n    d.dept_name,\n    COUNT(DISTINCT e.emp_no) AS current_employee_count,\n    ROUND(AVG(s.salary), 2) AS avg_current_annual_salary\nFROM\n    departments d\nLEFT JOIN\n    dept_emp de\n    ON d.dept_no = de.dept_no\n    AND date('2026-10-01') BETWEEN date(de.from_date) AND date(de.to_date)\nLEFT JOIN\n    employees e\n    ON de.emp_no = e.emp_no\nLEFT JOIN\n    salaries s\n    ON e.emp_no = s.emp_no\n    AND date('2026-10-01') BETWEEN date(s.from_date) AND date(s.to_date)\nGROUP BY\n    d.dept_name\nORDER BY\n    d.dept_name;",
