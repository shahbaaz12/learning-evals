    "id": "q003",
    "difficulty": "intermediate",
    "question": "As of 2026-10-01, show every department name, its current employee count, and average current annual salary rounded to two decimals. Include empty departments with count 0 and average NULL. Order by department name.",
    "sql": "SELECT\n    d.dept_name,\n    COUNT(de.emp_no) AS current_employee_count,\n    ROUND(AVG(s.salary), 2) AS average_current_annual_salary\nFROM departments d\nLEFT JOIN dept_emp de\n    ON d.dept_no = de.dept_no\n   AND de.from_date <= '2026-10-01'\n   AND de.to_date > '2026-10-01'\nLEFT JOIN salaries s\n    ON de.emp_no = s.emp_no\n   AND s.from_date <= '2026-10-01'\n   AND s.to_date > '2026-10-01'\nGROUP BY d.dept_no, d.dept_name\nORDER BY d.dept_name;",
