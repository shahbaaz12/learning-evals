  {
    "id": "q006",
    "difficulty": "difficult",
    "question": "As of 2026-10-01, which current employees received at least a 10 percent raise from their immediately previous salary to their current salary? Exclude employees with no previous salary. Return employee ID, first name, last name, current department name, previous salary, current salary, and percentage raise rounded to two decimals. Order by percentage raise descending, then employee ID ascending.",
    "sql": "WITH current_emp AS (\n    SELECT e.emp_no, e.first_name, e.last_name, d.dept_name\n    FROM employees e\n    JOIN dept_emp de ON e.emp_no = de.emp_no\n    JOIN departments d ON de.dept_no = d.dept_no\n    WHERE de.from_date <= '2026-10-01' AND de.to_date > '2026-10-01'\n),\ncurrent_sal AS (\n    SELECT s.emp_no, s.salary AS current_salary, s.from_date AS current_from_date\n    FROM salaries s\n    WHERE s.from_date <= '2026-10-01' AND s.to_date > '2026-10-01'\n),\nprev_sal AS (\n    SELECT cs.emp_no,\n           (SELECT s2.salary\n            FROM salaries s2\n            WHERE s2.emp_no = cs.emp_no\n              AND s2.to_date = cs.current_from_date\n            ORDER BY s2.from_date DESC\n            LIMIT 1) AS previous_salary\n    FROM current_sal cs\n)\nSELECT ce.emp_no,\n       ce.first_name,\n       ce.last_name,\n       ce.dept_name,\n       ps.previous_salary,\n       cs.current_salary,\n       ROUND((cs.current_salary - ps.previous_salary) * 100.0 / ps.previous_salary, 2) AS percentage_raise\nFROM current_emp ce\nJOIN current_sal cs ON ce.emp_no = cs.emp_no\nJOIN prev_sal ps ON ce.emp_no = ps.emp_no\nWHERE ps.previous_salary IS NOT NULL\n  AND (cs.current_salary - ps.previous_salary) * 100.0 / ps.previous_salary >= 10\nORDER BY percentage_raise DESC, ce.emp_no ASC;",
