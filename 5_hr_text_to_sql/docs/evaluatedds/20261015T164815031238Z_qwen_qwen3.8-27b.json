  {
    "id": "q005",
    "difficulty": "difficult",
    "question": "As of 2026-10-01, list current employees at the two highest distinct salary ranks in each department, including ties. Return department name, employee ID, first name, last name, salary, and salary rank. Order by department name, rank, then employee ID.",
    "sql": "WITH current_employees AS (\n    SELECT\n        e.emp_no,\n        e.first_name,\n        e.last_name,\n        d.dept_no,\n        s.salary\n    FROM employees e\n    JOIN dept_emp de ON e.emp_no = de.emp_no\n    JOIN departments d ON de.dept_no = d.dept_no\n    JOIN salaries s ON e.emp_no = s.emp_no\n    WHERE de.from_date <= '2026-10-01' AND de.to_date > '2026-10-01'\n      AND s.from_date <= '2026-10-01' AND s.to_date > '2026-10-01'\n),\nsalary_ranks AS (\n    SELECT\n        ce.dept_no,\n        ce.emp_no,\n        ce.first_name,\n        ce.last_name,\n        ce.salary,\n        DENSE_RANK() OVER (PARTITION BY ce.dept_no ORDER BY ce.salary DESC) AS salary_rank\n    FROM current_employees ce\n)\nSELECT\n    d.dept_name,\n    sr.emp_no,\n    sr.first_name,\n    sr.last_name,\n    sr.salary,\n    sr.salary_rank\nFROM salary_ranks sr\nJOIN departments d ON sr.dept_no = d.dept_no\nWHERE sr.salary_rank <= 2\nORDER BY d.dept_name, sr.salary_rank, sr.emp_no;",
