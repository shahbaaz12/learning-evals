  {
    "id": "q004",
    "difficulty": "intermediate",
    "question": "As of 2026-10-01, which current Development employees earn more than the average current Development salary? Return employee ID, first name, last name, and annual salary. Order by salary descending, then employee ID ascending.",
    "sql": "SELECT e.emp_no, e.first_name, e.last_name, s.salary\nFROM employees e\nJOIN dept_emp de ON e.emp_no = de.emp_no\nJOIN departments d ON de.dept_no = d.dept_no\nJOIN salaries s ON e.emp_no = s.emp_no\nWHERE d.dept_name = 'Development'\n  AND de.from_date <= '2026-10-01' AND de.to_date > '2026-10-01'\n  AND s.from_date <= '2026-10-01' AND s.to_date > '2026-10-01'\n  AND s.salary > (\n    SELECT AVG(s2.salary)\n    FROM dept_emp de2\n    JOIN departments d2 ON de2.dept_no = d2.dept_no\n    JOIN salaries s2 ON de2.emp_no = s2.emp_no\n    WHERE d2.dept_name = 'Development'\n      AND de2.from_date <= '2026-10-01' AND de2.to_date > '2026-10-01'\n      AND s2.from_date <= '2026-10-01' AND s2.to_date > '2026-10-01'\n  )\nORDER BY s.salary DESC, e.emp_no ASC;",
